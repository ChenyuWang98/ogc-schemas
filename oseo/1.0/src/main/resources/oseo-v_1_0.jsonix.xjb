<jaxb:bindings version="3.0" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
	xmlns:xs="http://www.w3.org/2001/XMLSchema" 
	xmlns:jsonix="http://jsonix.highsource.org/customizations"
	jaxb:extensionBindingPrefixes="jsonix">

	<jaxb:bindings schemaLocation="http://schemas.opengis.net/oseo/1.0/oseo.xsd" node="/xs:schema">
		<jsonix:mapping package="net.opengis.oseo.v_1_0" name="OSEO_1_0"/>
	</jaxb:bindings>

</jaxb:bindings>