<jaxb:bindings version="3.0" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
	xmlns:xs="http://www.w3.org/2001/XMLSchema" 
	xmlns:jsonix="http://jsonix.highsource.org/customizations"
	jaxb:extensionBindingPrefixes="jsonix">

	<jaxb:bindings 
		schemaLocation="http://schemas.opengis.net/wcst/1.1/wcstTransaction.xsd" 
		node="/xs:schema">
		<jsonix:packageMapping packageName="net.opengis.wcst.v_1_1" spaceName="WCST_1_1"/>
	</jaxb:bindings>
</jaxb:bindings>