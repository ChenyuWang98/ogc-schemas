<jaxb:bindings version="3.0" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
	xmlns:xs="http://www.w3.org/2001/XMLSchema" 
	xmlns:jsonix="http://jsonix.highsource.org/customizations"
	jaxb:extensionBindingPrefixes="jsonix">

	<jaxb:bindings schemaLocation="http://schemas.opengis.net/gml/3.3/extdBaseTypes.xsd" 
		node="/xs:schema">
		<jsonix:packageMapping packageName="net.opengis.gml.v_3_3.xbt" spaceName="GML_XBT_3_3"/>
	</jaxb:bindings>

</jaxb:bindings>