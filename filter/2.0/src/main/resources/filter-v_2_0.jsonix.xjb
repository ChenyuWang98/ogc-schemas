<jaxb:bindings version="3.0" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
	xmlns:xs="http://www.w3.org/2001/XMLSchema" 
	xmlns:jsonix="http://jsonix.highsource.org/customizations"
	jaxb:extensionBindingPrefixes="jsonix">
	<jaxb:bindings 
		schemaLocation="http://schemas.opengis.net/filter/2.0/filter.xsd" 
		node="/xs:schema">
		<jsonix:packageMapping packageName="net.opengis.filter.v_2_0" spaceName="Filter_2_0"/>
	</jaxb:bindings>
</jaxb:bindings>